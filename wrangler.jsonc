/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "workflows-starter-template",
	"main": "worker/index.ts",
	"compatibility_date": "2025-10-08",
	"observability": {
		"enabled": true
	}
	// No `migrations` key: this repo's Cloudflare GitHub integration deploys via the
	// versioned/gradual-deployments API, which rejects ANY Durable Object migration
	// entry outright (error 10211) — including a deleted_classes one. The original
	// WorkflowStatusDO namespace is just left orphaned/unused rather than formally
	// retired; that requires a plain (non-versioned) `wrangler deploy` run manually,
	// which this automatic pipeline doesn't do.
}
